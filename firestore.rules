rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sauvegarde privée du joueur : pièces, collection, liste d'amis, compteurs,
    // inventaire de packs (Shop) et calendrier de connexion (récompenses
    // quotidiennes de mieux en mieux).
    match /playerSaves/{userId} {
      function ownsSave() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read: if ownsSave();
      allow create, update: if ownsSave()
        && request.resource.data.keys().hasOnly(['coins', 'firstPack', 'collection', 'friends', 'packsOpened', 'packStock', 'streakDate', 'streak', 'claimedDays', 'fusions', 'packsBought', 'freePacks', 'marketSales', 'marketEarned', 'marketBuys', 'xp', 'quests', 'questBaseline', 'achievements', 'notifications', 'updatedAt', 'freeDate', 'freeUsed'])
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 1000000000
        && request.resource.data.firstPack is bool
        && request.resource.data.collection is list
        && request.resource.data.collection.size() <= 10000
        && request.resource.data.friends is list
        && request.resource.data.friends.size() <= 500
        && request.resource.data.packsOpened is int
        && request.resource.data.packsOpened >= 0
        /* Quêtes / succès / niveau / notifications : compteurs cumulés,
           XP, ids de quêtes et de succès, base de référence et historique. */
        && (!('fusions' in request.resource.data) || (request.resource.data.fusions is int && request.resource.data.fusions >= 0))
        && (!('packsBought' in request.resource.data) || (request.resource.data.packsBought is int && request.resource.data.packsBought >= 0))
        && (!('freePacks' in request.resource.data) || (request.resource.data.freePacks is int && request.resource.data.freePacks >= 0))
        && (!('marketSales' in request.resource.data) || (request.resource.data.marketSales is int && request.resource.data.marketSales >= 0))
        && (!('marketEarned' in request.resource.data) || (request.resource.data.marketEarned is int && request.resource.data.marketEarned >= 0))
        && (!('marketBuys' in request.resource.data) || (request.resource.data.marketBuys is int && request.resource.data.marketBuys >= 0))
        && (!('xp' in request.resource.data) || (request.resource.data.xp is int && request.resource.data.xp >= 0))
        && (!('quests' in request.resource.data) || (request.resource.data.quests is list && request.resource.data.quests.size() <= 500))
        && (!('achievements' in request.resource.data) || (request.resource.data.achievements is list && request.resource.data.achievements.size() <= 200))
        // `questBaseline` : champ hérité (les quêtes se mesurent désormais à vie).
        // Il reste toléré pour que les anciennes sauvegardes puissent être
        // réécrites avec merge sans être refusées ; le jeu ne l'écrit plus.
        && (!('questBaseline' in request.resource.data) || request.resource.data.questBaseline is map)
        // `freeDate` / `freeUsed` : anciens champs « 3 gratuits/jour », remplacés
        // par streakDate/streak/claimedDays. Le jeu les supprime désormais du
        // document au chargement (FieldValue.delete) ; ils restent tolérés pour
        // que les anciennes sauvegardes puissent être réécrites avec merge sans
        // être refusées (leur présence fait échouer hasOnly) ; le jeu ne les
        // écrit plus.
        && (!('freeDate' in request.resource.data)
            || (request.resource.data.freeDate is string
                && request.resource.data.freeDate.size() <= 10))
        && (!('freeUsed' in request.resource.data)
            || (request.resource.data.freeUsed is number
                && request.resource.data.freeUsed >= 0
                && request.resource.data.freeUsed <= 10000))
        && (!('notifications' in request.resource.data) || (request.resource.data.notifications is list && request.resource.data.notifications.size() <= 50))
        && (!('packStock' in request.resource.data)
            || (request.resource.data.packStock is map
                && request.resource.data.packStock.keys().hasOnly(['classic', 'rare', 'legend', 'video', 'ultra'])
                && request.resource.data.packStock.classic is int
                && request.resource.data.packStock.classic >= 0
                && request.resource.data.packStock.classic <= 100000
                && request.resource.data.packStock.rare is int
                && request.resource.data.packStock.rare >= 0
                && request.resource.data.packStock.rare <= 100000
                && request.resource.data.packStock.legend is int
                && request.resource.data.packStock.legend >= 0
                && request.resource.data.packStock.legend <= 100000
                && request.resource.data.packStock.video is int
                && request.resource.data.packStock.video >= 0
                && request.resource.data.packStock.video <= 100000
                && (!('ultra' in request.resource.data.packStock)
                    || (request.resource.data.packStock.ultra is int
                        && request.resource.data.packStock.ultra >= 0
                        && request.resource.data.packStock.ultra <= 100000))))
        /* Calendrier de connexion : date du dernier cadeau récupéré
           (AAAA-MM-JJ), série de jours d'affilée, dates cochées ce mois-ci. */
        && (!('streakDate' in request.resource.data)
            || (request.resource.data.streakDate is string
                && request.resource.data.streakDate.size() <= 10))
        && (!('streak' in request.resource.data)
            || (request.resource.data.streak is int
                && request.resource.data.streak >= 0
                && request.resource.data.streak <= 10000))
        && (!('claimedDays' in request.resource.data)
            || (request.resource.data.claimedDays is list
                && request.resource.data.claimedDays.size() <= 31))
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Profil public (pseudo, avatar, code ami, stats, collection) : lisible par
    // tout joueur connecté (c'est ce que voient les amis), modifiable uniquement
    // par son propriétaire.
    match /playerProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() <= 24
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 300000
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.matches('^REFS-[A-Z0-9]{6}$')
        // Liste publique d'amis (uids), pour afficher les amis d'un profil et
        // les amis en commun.
        && (!('friends' in request.resource.data)
            || (request.resource.data.friends is list
                && request.resource.data.friends.size() <= 500));
      allow delete: if false;
    }

    // Annuaire code ami -> uid (recherche d'amis par code).
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Demandes d'ami : friendRequests/{fromUid}__{toUid}. L'expéditeur crée
    // la demande, le destinataire l'accepte ou la refuse (« on ne devient ami
    // que si l'autre accepte »). Les deux parties peuvent lire et mettre à jour
    // la demande ; personne d'autre.
    //
    // L'identifiant du document porte les deux uids ({fromUid}__{toUid}) :
    // on s'en sert pour autoriser la lecture, y compris quand le document
    // N'EXISTE PAS (resource == null). Sans cela, « ai-je déjà reçu une
    // demande de ce joueur ? » renvoyait permission-denied au lieu de « non ».
    match /friendRequests/{requestId} {
      function uidInId() {
        return request.auth != null
          && (requestId.matches('^' + request.auth.uid + '__.+$')
              || requestId.matches('^.+__' + request.auth.uid + '$'));
      }
      function isParty() {
        return request.auth != null
          && resource != null
          && (request.auth.uid == resource.data.fromUid
              || request.auth.uid == resource.data.toUid);
      }
      // La recherche d'une demande inverse absente doit pouvoir retourner
      // « inexistante » ; les documents existants restent privés aux parties.
      allow get: if request.auth != null && (resource == null || isParty());
      allow list: if isParty();
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid.size() > 0
        && requestId == request.resource.data.fromUid + '__' + request.resource.data.toUid
        && request.resource.data.status == 'pending';
      allow update: if isParty()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;
      allow delete: if false;
    }

    // Le marché fonctionne par mise en réserve. Les règles lient chaque
    // changement d'état à une modification atomique de la sauvegarde de
    // l'acteur. Une annonce/cadeau ne peut être consommé qu'une fois.
    // Une annonce peut porter une CARTE (cardId) ou un PACK (packType
    // 'classic' | 'rare'). Les deux sont mises en réserve dans la sauvegarde
    // du vendeur avant d'être listées, puis transférées dans la même
    // transaction que le paiement (cartes ↔ collection, packs ↔ packStock).
    match /marketListings/{listingId} {
      function signedIn() { return request.auth != null; }
      function beforeSave() { return get(/databases/$(database)/documents/playerSaves/$(request.auth.uid)).data; }
      function afterSave() { return getAfter(/databases/$(database)/documents/playerSaves/$(request.auth.uid)).data; }
      function hasStock() {
        return beforeSave().packStock is map && afterSave().packStock is map;
      }
      function stockKeysOk() {
        return afterSave().packStock.keys().hasOnly(['classic', 'rare', 'legend', 'video', 'ultra'])
          && afterSave().packStock.classic is int && afterSave().packStock.classic >= 0 && afterSave().packStock.classic <= 100000
          && afterSave().packStock.legend is int && afterSave().packStock.legend >= 0 && afterSave().packStock.legend <= 100000
          && afterSave().packStock.rare is int && afterSave().packStock.rare >= 0 && afterSave().packStock.rare <= 100000
          && afterSave().packStock.video is int && afterSave().packStock.video >= 0 && afterSave().packStock.video <= 100000
          && (!('ultra' in afterSave().packStock)
              || (afterSave().packStock.ultra is int && afterSave().packStock.ultra >= 0 && afterSave().packStock.ultra <= 100000));
      }
      function stockUnchanged() {
        return (!('packStock' in beforeSave()) && !('packStock' in afterSave()))
          || (afterSave().packStock == beforeSave().packStock);
      }
      function cardRemoved(card) {
        return card in beforeSave().collection
          && afterSave().collection.size() == beforeSave().collection.size() - 1
          && beforeSave().collection.hasAll(afterSave().collection)
          && afterSave().collection.hasAll(beforeSave().collection.removeAll([card]));
      }
      function cardAdded(card) {
        return card in afterSave().collection
          && afterSave().collection.size() == beforeSave().collection.size() + 1
          && afterSave().collection.hasAll(beforeSave().collection)
          && beforeSave().collection.hasAll(afterSave().collection.removeAll([card]));
      }
      function packRemoved(packType) {
        return hasStock() && stockKeysOk()
          && afterSave().packStock.legend == beforeSave().packStock.get('legend', 0)
          && afterSave().packStock.video == beforeSave().packStock.get('video', 0)
          && afterSave().packStock.get('ultra', 0) == beforeSave().packStock.get('ultra', 0)
          && afterSave().collection == beforeSave().collection
          && (packType == 'classic'
            ? afterSave().packStock.classic == beforeSave().packStock.classic - 1
              && afterSave().packStock.rare == beforeSave().packStock.rare
            : afterSave().packStock.rare == beforeSave().packStock.rare - 1
              && afterSave().packStock.classic == beforeSave().packStock.classic);
      }
      function packAdded(packType) {
        return hasStock() && stockKeysOk()
          && afterSave().packStock.legend == beforeSave().packStock.get('legend', 0)
          && afterSave().packStock.video == beforeSave().packStock.get('video', 0)
          && afterSave().packStock.get('ultra', 0) == beforeSave().packStock.get('ultra', 0)
          && afterSave().collection == beforeSave().collection
          && (packType == 'classic'
            ? afterSave().packStock.classic == beforeSave().packStock.classic + 1
              && afterSave().packStock.rare == beforeSave().packStock.rare
            : afterSave().packStock.rare == beforeSave().packStock.rare + 1
              && afterSave().packStock.classic == beforeSave().packStock.classic);
      }
      function validPrice() {
        return request.resource.data.price is int && request.resource.data.price >= 0 && request.resource.data.price <= 1000000000;
      }
      function validStatusOpen() {
        return request.resource.data.status == 'open' && request.resource.data.buyerUid == '';
      }
      // Le marché est global : les annonces en vente sont lisibles par tous et
      // achetables par n'importe quel joueur connecté (pas seulement un ami).
      function listed() {
        return resource.data.status == 'open';
      }
      allow read: if signedIn() && (resource.data.sellerUid == request.auth.uid || listed());
      allow create: if signedIn() && (
        // Carte mise en vente : 1 exemplaire retiré de la collection.
        (request.resource.data.keys().hasOnly(['sellerUid', 'cardId', 'price', 'status', 'buyerUid', 'createdAt'])
          && request.resource.data.sellerUid == request.auth.uid
          && request.resource.data.cardId is string && request.resource.data.cardId.size() > 0 && request.resource.data.cardId.size() <= 100
          && validPrice() && validStatusOpen()
          && request.resource.data.createdAt is timestamp
          && cardRemoved(request.resource.data.cardId)
          && afterSave().coins == beforeSave().coins
          && stockUnchanged())
        ||
        // Pack mis en vente : 1 pack retiré de l'inventaire.
        (request.resource.data.keys().hasOnly(['sellerUid', 'packType', 'price', 'status', 'buyerUid', 'createdAt'])
          && request.resource.data.sellerUid == request.auth.uid
          && (request.resource.data.packType == 'classic' || request.resource.data.packType == 'rare')
          && validPrice() && validStatusOpen()
          && request.resource.data.createdAt is timestamp
          && packRemoved(request.resource.data.packType)
          && afterSave().coins == beforeSave().coins)
      );
      allow update: if signedIn() && (
        // Le vendeur retire une annonce ouverte et récupère la carte / le pack.
        (resource.data.sellerUid == request.auth.uid && resource.data.status == 'open'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && ('packType' in resource.data
            ? packAdded(resource.data.packType)
            : cardAdded(resource.data.cardId) && stockUnchanged())
          && afterSave().coins == beforeSave().coins)
        ||
        // L'acheteur paie et reçoit la carte / le pack dans la même transaction.
        // Marché global : l'acheteur n'a pas besoin d'être un ami du vendeur.
        (resource.data.sellerUid != request.auth.uid && resource.data.status == 'open'
          && request.resource.data.status == 'sold' && request.resource.data.buyerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyerUid'])
          && ('packType' in resource.data
            ? packAdded(resource.data.packType)
            : cardAdded(resource.data.cardId) && stockUnchanged())
          && afterSave().coins == beforeSave().coins - resource.data.price)
        ||
        // Achat d'une offre acceptée : l'offre, l'annonce et la sauvegarde
        // changent atomiquement, sans permettre de réutiliser une acceptation.
        (resource.data.sellerUid != request.auth.uid && resource.data.status == 'open'
          && !('packType' in resource.data)
          && request.resource.data.status == 'sold' && request.resource.data.buyerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyerUid', 'price', 'offerId'])
          && request.resource.data.offerId is string
          && get(/databases/$(database)/documents/marketOffers/$(request.resource.data.offerId)).data.status == 'accepted'
          && get(/databases/$(database)/documents/marketOffers/$(request.resource.data.offerId)).data.listingId == listingId
          && get(/databases/$(database)/documents/marketOffers/$(request.resource.data.offerId)).data.buyerUid == request.auth.uid
          && get(/databases/$(database)/documents/marketOffers/$(request.resource.data.offerId)).data.sellerUid == resource.data.sellerUid
          && request.resource.data.price == get(/databases/$(database)/documents/marketOffers/$(request.resource.data.offerId)).data.price
          && getAfter(/databases/$(database)/documents/marketOffers/$(request.resource.data.offerId)).data.status == 'completed'
          && cardAdded(resource.data.cardId) && stockUnchanged()
          && afterSave().coins == beforeSave().coins - request.resource.data.price)
        ||
        // Le vendeur encaisse une seule fois, y compris après reconnexion.
        (resource.data.sellerUid == request.auth.uid && resource.data.status == 'sold'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && afterSave().coins == beforeSave().coins + resource.data.price
          && afterSave().collection == beforeSave().collection
          && stockUnchanged())
      );
      allow delete: if false;
    }

    // Les négociations ne réservent ni pièces ni carte : l'achat final est
    // effectué séparément et échoue si l'annonce a entre-temps disparu.
    match /marketOffers/{offerId} {
      function signedIn() { return request.auth != null; }
      function listing() { return get(/databases/$(database)/documents/marketListings/$(request.resource.data.listingId)).data; }
      function party() { return signedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid); }
      function actorTurn() { return (resource.data.turn == 'seller' && resource.data.sellerUid == request.auth.uid)
        || (resource.data.turn == 'buyer' && resource.data.buyerUid == request.auth.uid); }
      function priceValid() { return request.resource.data.price is int && request.resource.data.price >= 0
        && request.resource.data.price < resource.data.listingPrice; }
      allow read: if party();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['listingId', 'sellerUid', 'buyerUid', 'cardId', 'listingPrice', 'price', 'status', 'turn', 'createdAt'])
        && request.resource.data.listingId is string
        && request.resource.data.buyerUid == request.auth.uid && request.resource.data.sellerUid != request.auth.uid
        && listing().status == 'open' && !('packType' in listing())
        && request.resource.data.sellerUid == listing().sellerUid && request.resource.data.cardId == listing().cardId
        && request.resource.data.listingPrice == listing().price
        && request.resource.data.price is int && request.resource.data.price >= 0 && request.resource.data.price < listing().price
        && request.resource.data.status == 'pending' && request.resource.data.turn == 'seller'
        && request.resource.data.createdAt is timestamp;
      allow update: if party() && (
        (resource.data.status == 'pending' && actorTurn() && listing().status == 'open'
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status in ['accepted', 'rejected'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price', 'turn'])
              && priceValid() && request.resource.data.turn == (resource.data.turn == 'seller' ? 'buyer' : 'seller'))))
        || (resource.data.status == 'accepted' && resource.data.buyerUid == request.auth.uid
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && getAfter(/databases/$(database)/documents/marketListings/$(resource.data.listingId)).data.status == 'sold'
          && getAfter(/databases/$(database)/documents/marketListings/$(resource.data.listingId)).data.offerId == offerId
          && getAfter(/databases/$(database)/documents/marketListings/$(resource.data.listingId)).data.buyerUid == request.auth.uid)
      );
      allow delete: if false;
    }

    match /coinGifts/{giftId} {
      function signedIn() { return request.auth != null; }
      function beforeSave() { return get(/databases/$(database)/documents/playerSaves/$(request.auth.uid)).data; }
      function afterSave() { return getAfter(/databases/$(database)/documents/playerSaves/$(request.auth.uid)).data; }
      function stockUnchanged() {
        return (!('packStock' in beforeSave()) && !('packStock' in afterSave()))
          || (afterSave().packStock == beforeSave().packStock);
      }
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'amount', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid
        && request.resource.data.toUid in beforeSave().friends
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000
        && request.resource.data.status == 'pending' && request.resource.data.createdAt is timestamp
        && afterSave().coins == beforeSave().coins - request.resource.data.amount
        && afterSave().collection == beforeSave().collection
        && stockUnchanged();
      allow update: if signedIn() && (
        // Le destinataire encaisse le cadeau une seule fois.
        (resource.data.toUid == request.auth.uid
          && resource.data.status == 'pending' && request.resource.data.status == 'claimed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && afterSave().coins == beforeSave().coins + resource.data.amount
          && afterSave().collection == beforeSave().collection
          && stockUnchanged())
        ||
        // L'expéditeur annule un cadeau pas encore récupéré : il est remboursé.
        (resource.data.fromUid == request.auth.uid
          && resource.data.status == 'pending' && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && afterSave().coins == beforeSave().coins + resource.data.amount
          && afterSave().collection == beforeSave().collection
          && stockUnchanged())
      );
      allow delete: if false;
    }

    // Les anciennes propositions d'échange (trades/) sont désactivées :
    // le marché (cartes/packs en vente) est le seul moyen d'obtenir les
    // cartes d'un ami. Aucune correspondance trades n'est exposée.
  }
}
